# Copia este archivo a .env y rellena los valores reales (nunca lo subas a git).
N8N_WEBHOOK_URL=
# Opcional pero recomendado: se envía como cabecera X-Webhook-Secret (Header Auth en n8n)
N8N_WEBHOOK_SECRET=
RECAPTCHA_SECRET_KEY=
# Opcional: dominios permitidos para el token, separados por comas
RECAPTCHA_HOSTNAMES=
VITE_RECAPTCHA_SITE_KEY=
